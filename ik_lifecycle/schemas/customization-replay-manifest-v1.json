{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ik.hermes.customization-replay-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "entries"],
  "properties": {
    "schema_id": {"const": "ik.hermes.customization-replay-manifest.v1"},
    "entries": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "commit", "disposition", "supported_edge", "summary"],
        "properties": {
          "order": {"type": "integer", "minimum": 1, "maximum": 12},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "disposition": {
            "enum": ["upstream-superseded", "replay-at-supported-edge", "adapt", "reject"]
          },
          "supported_edge": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
