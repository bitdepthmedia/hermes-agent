#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HERMES_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
STACK_ROOT="$(cd "${HERMES_ROOT}/../.." && pwd)"
ERNIE_HOME="${STACK_ROOT}/config/ik-agents/hermes-ernie"
ACCESS_NODE_HOME="${STACK_ROOT}/config/ik-agents/orchestrator-access-node"
ACCESS_NODE_PROFILE_SOURCE="${HERMES_ROOT}/ik_profiles/orchestrator-access-node"
ACCESS_NODE_LABEL="com.ik.orchestrator-access-node"
ACCESS_NODE_URL="http://127.0.0.1:8643/v1"
HEARTBEAT_JOB_ID="1c4376c9c569"

cd "${HERMES_ROOT}"

usage() {
  cat <<'EOF'
Usage: scripts/ik-orchestrator-access-node <status|profile-check|profile-deploy|restart|heartbeat|rollback> [ref]

Commands:
  status         Show git cleanliness, profile drift, live symlink, launchd state, and API probe.
  profile-check  Compare versioned access-node profile source with the live profile files.
  profile-deploy Deploy versioned access-node profile source to the live profile with backups.
  restart        Restart the live access-node LaunchAgent.
  heartbeat      Trigger the orchestrator heartbeat cron and show its status.
  rollback REF   Revert REF, restart the access node, then run heartbeat.
EOF
}

require_clean_tree() {
  if [[ -n "$(git status --porcelain)" ]]; then
    echo "ERROR: Hermes checkout is dirty. Commit, revert, or stash first." >&2
    git status --short
    exit 1
  fi
}

python_bin() {
  if [[ -x "${HERMES_ROOT}/.venv/bin/python" ]]; then
    printf '%s\n' "${HERMES_ROOT}/.venv/bin/python"
  else
    command -v python3
  fi
}

profile_files() {
  printf '%s\n' \
    "SOUL.md" \
    "memories/USER.md" \
    "memories/MEMORY.md"
}

profile_check_cmd() {
  local drift=0
  while IFS= read -r rel; do
    local src="${ACCESS_NODE_PROFILE_SOURCE}/${rel}"
    local dst="${ACCESS_NODE_HOME}/${rel}"
    if [[ ! -f "${src}" ]]; then
      echo "profile-source-missing: ${rel}"
      drift=1
      continue
    fi
    if [[ ! -f "${dst}" ]]; then
      echo "profile-live-missing: ${rel}"
      drift=1
      continue
    fi
    if cmp -s "${src}" "${dst}"; then
      echo "profile-ok: ${rel}"
    else
      echo "profile-drift: ${rel}"
      drift=1
    fi
  done < <(profile_files)
  return "${drift}"
}

profile_deploy_cmd() {
  require_clean_tree
  local stamp backup_dir
  stamp="$(date +%Y%m%d-%H%M%S)"
  backup_dir="${ACCESS_NODE_HOME}/backups/profile-sync-${stamp}"
  mkdir -p "${backup_dir}/memories" "${ACCESS_NODE_HOME}/memories"
  while IFS= read -r rel; do
    local src="${ACCESS_NODE_PROFILE_SOURCE}/${rel}"
    local dst="${ACCESS_NODE_HOME}/${rel}"
    if [[ ! -f "${src}" ]]; then
      echo "ERROR: missing profile source ${src}" >&2
      exit 1
    fi
    if [[ -f "${dst}" ]]; then
      cp -p "${dst}" "${backup_dir}/${rel}"
    fi
    install -m 600 "${src}" "${dst}"
    echo "deployed: ${rel}"
  done < <(profile_files)
  echo "backup: ${backup_dir}"
}

status_cmd() {
  echo "branch: $(git branch --show-current || true)"
  echo "head: $(git rev-parse --short HEAD) $(git log -1 --pretty=%s)"
  if [[ -z "$(git status --porcelain)" ]]; then
    echo "git: clean"
  else
    echo "git: dirty"
    git status --short
  fi

  if profile_check_cmd >/tmp/ik-orchestrator-access-node-profile-check.txt; then
    echo "profile: synced"
  else
    echo "profile: drift"
  fi
  cat /tmp/ik-orchestrator-access-node-profile-check.txt

  if [[ -L /Users/react/opt/hermes-agent ]]; then
    echo "live-symlink: $(readlink /Users/react/opt/hermes-agent)"
  else
    echo "live-symlink: missing or not a symlink"
  fi

  launchctl print "gui/$(id -u)/${ACCESS_NODE_LABEL}" 2>/dev/null | sed -n '1,18p' || true
  code="$(curl -sS -o /tmp/ik-orchestrator-access-node-models.json -w '%{http_code}' \
    -H 'Authorization: Bearer invalid' "${ACCESS_NODE_URL}/models" || true)"
  echo "access-node-api-invalid-key-probe: ${code}"
}

restart_cmd() {
  launchctl kickstart -k "gui/$(id -u)/${ACCESS_NODE_LABEL}"
  sleep 2
  launchctl print "gui/$(id -u)/${ACCESS_NODE_LABEL}" | sed -n '1,24p'
}

heartbeat_cmd() {
  if [[ ! -f "${ERNIE_HOME}/.env" ]]; then
    echo "ERROR: missing ${ERNIE_HOME}/.env" >&2
    exit 1
  fi

  set -a
  # shellcheck disable=SC1091
  source "${ERNIE_HOME}/.env"
  set +a
  export HERMES_HOME="${ERNIE_HOME}"

  "$(python_bin)" - <<PY
from cron.jobs import trigger_job, get_job
from cron.scheduler import tick

job_id = "${HEARTBEAT_JOB_ID}"
job = trigger_job(job_id)
print("triggered", bool(job), job.get("name") if job else None)
executed = tick(verbose=True)
print("executed", executed)
job = get_job(job_id)
print("last_status", job.get("last_status"))
print("last_error", job.get("last_error"))
print("last_run_at", job.get("last_run_at"))
print("next_run_at", job.get("next_run_at"))
PY
}

rollback_cmd() {
  ref="${1:-}"
  if [[ -z "${ref}" ]]; then
    echo "ERROR: rollback requires a commit/ref to revert." >&2
    usage
    exit 1
  fi
  require_clean_tree
  git revert --no-edit "${ref}"
  restart_cmd
  heartbeat_cmd
}

case "${1:-}" in
  status)
    status_cmd
    ;;
  profile-check)
    profile_check_cmd
    ;;
  profile-deploy)
    profile_deploy_cmd
    ;;
  restart)
    restart_cmd
    ;;
  heartbeat)
    heartbeat_cmd
    ;;
  rollback)
    shift
    rollback_cmd "${1:-}"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "ERROR: unknown command: $1" >&2
    usage
    exit 1
    ;;
esac
