#!/bin/sh
set -eu

: "${IK_CELL_ROOT:?IK_CELL_ROOT is required}"
: "${IK_RELEASE_IMAGE:?IK_RELEASE_IMAGE is required}"
: "${IK_RELEASE_MOUNT:?IK_RELEASE_MOUNT is required}"
: "${IK_CELL_SERVICE_ROLE:=gateway}"

cell_root=$IK_CELL_ROOT
if ! /usr/sbin/diskutil info "$IK_RELEASE_MOUNT" >/dev/null 2>&1; then
    [ -d "$IK_RELEASE_IMAGE" ] || exit 70
    /bin/mkdir -p "$IK_RELEASE_MOUNT"
    /usr/bin/hdiutil attach -nobrowse -mountpoint "$IK_RELEASE_MOUNT" "$IK_RELEASE_IMAGE" >/dev/null
fi
[ -L "$cell_root/current-release" ] || exit 72
[ -L "$cell_root/current-profile" ] || exit 73

deployment=$(cd -P "$cell_root/current-release" && pwd)
profile_bundle=$(cd -P "$cell_root/current-profile" && pwd)
release=$deployment
if [ -r "$deployment/deployment-manifest.json" ]; then
    [ -r "$deployment/shared-release.path" ] || exit 74
    IFS= read -r release < "$deployment/shared-release.path"
    [ -d "$release" ] || exit 74
fi
python="$release/surfaces/python-runtime/bin/python"
manifest="$release/runtime-manifest.json"
[ -x "$python" ] || exit 75
[ -r "$manifest" ] || exit 76

"$python" -c 'import json,sys; d=json.load(open(sys.argv[1], encoding="utf-8")); raise SystemExit(0 if d.get("status")=="SEALED_DEPLOYABLE_RUNTIME" else 77)' "$manifest"

export PYTHONPATH="$release/source"

load_credentials() {
    credential_file=$1
    [ -n "$credential_file" ] || return 0
    [ -f "$credential_file" ] && [ ! -L "$credential_file" ] || exit 78
    set -a
    . "$credential_file"
    set +a
}

case "$IK_CELL_SERVICE_ROLE" in
    model)
        model_runtime="$release/surfaces/model-runtime/ollama"
        [ -x "$model_runtime" ] || exit 79
        exec "$model_runtime" serve
        ;;
    router)
        : "${HERMES_HOME:?HERMES_HOME is required}"
        [ "$HERMES_HOME" = "$cell_root/current-profile/primary" ] || exit 80
        load_credentials "${IK_CELL_CREDENTIAL_FILE:-}"
        : "${IK_SERVICE_HOST:=127.0.0.1}"
        : "${IK_SERVICE_PORT:?IK_SERVICE_PORT is required}"
        cd "$release/source"
        exec "$python" -m uvicorn ik_extensions.model_workers.router_service:app --host "$IK_SERVICE_HOST" --port "$IK_SERVICE_PORT"
        ;;
    compatibility-gateway)
        : "${HERMES_HOME:?HERMES_HOME is required}"
        [ "$HERMES_HOME" = "$cell_root/current-profile/primary" ] || exit 81
        load_credentials "${IK_CELL_CREDENTIAL_FILE:-}"
        load_credentials "${IK_CELL_SHARED_CREDENTIAL_FILE:-}"
        : "${IK_SERVICE_HOST:=127.0.0.1}"
        : "${IK_SERVICE_PORT:?IK_SERVICE_PORT is required}"
        [ -r "$deployment/compatibility/app.py" ] || exit 82
        cd "$deployment/compatibility"
        exec "$python" -m uvicorn app:app --host "$IK_SERVICE_HOST" --port "$IK_SERVICE_PORT"
        ;;
    gateway)
        : "${HERMES_HOME:?HERMES_HOME is required}"
        case "$HERMES_HOME" in
            "$cell_root/current-profile/primary"|"$cell_root/current-profile/fast") ;;
            *) exit 83 ;;
        esac
        cd "$release/source"
        exec "$python" -m hermes_cli.main gateway run --replace
        ;;
    *) exit 84 ;;
esac
