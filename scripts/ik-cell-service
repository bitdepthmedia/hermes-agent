#!/bin/sh
set -eu

: "${IK_CELL_ROOT:?IK_CELL_ROOT is required}"
: "${IK_RELEASE_IMAGE:?IK_RELEASE_IMAGE is required}"
: "${IK_RELEASE_MOUNT:?IK_RELEASE_MOUNT is required}"
: "${IK_CELL_SERVICE_ROLE:=gateway}"

cell_root=$IK_CELL_ROOT
require_port() {
    case "$1" in
        ''|*[!0-9]*) exit 86 ;;
    esac
    [ "$1" -ge 1024 ] && [ "$1" -le 65535 ] || exit 86
}

# Reject unsafe bind requests before any attempt to attach the runtime volume.
case "$IK_CELL_SERVICE_ROLE" in
    model)
        : "${OLLAMA_HOST:?OLLAMA_HOST is required}"
        case "$OLLAMA_HOST" in
            127.0.0.1:*) require_port "${OLLAMA_HOST#127.0.0.1:}" ;;
            *) exit 86 ;;
        esac
        ;;
    router)
        : "${IK_SERVICE_HOST:=127.0.0.1}"
        : "${IK_SERVICE_PORT:?IK_SERVICE_PORT is required}"
        [ "$IK_SERVICE_HOST" = "127.0.0.1" ] || exit 86
        require_port "$IK_SERVICE_PORT"
        ;;
esac

release_mount_parent=$(/usr/bin/dirname "$IK_RELEASE_MOUNT")
release_mount_is_active() {
    [ -d "$IK_RELEASE_MOUNT" ] || return 1
    mount_device=$(/usr/bin/stat -f %d "$IK_RELEASE_MOUNT") || return 1
    parent_device=$(/usr/bin/stat -f %d "$release_mount_parent") || return 1
    [ "$mount_device" != "$parent_device" ]
}

if ! release_mount_is_active; then
    [ -e "$IK_RELEASE_IMAGE" ] || exit 70
    /bin/mkdir -p "$IK_RELEASE_MOUNT"
    /usr/bin/hdiutil attach -nobrowse -mountpoint "$IK_RELEASE_MOUNT" "$IK_RELEASE_IMAGE" >/dev/null
fi
release_mount_is_active || exit 71
[ -L "$cell_root/current-release" ] || exit 72
[ -L "$cell_root/current-profile" ] || exit 73

deployment=$(cd -P "$cell_root/current-release" && pwd)
profile_bundle=$(cd -P "$cell_root/current-profile" && pwd)
release=$deployment
if [ -r "$deployment/deployment-manifest.json" ]; then
    [ -r "$deployment/shared-release.path" ] || exit 74
    IFS= read -r release < "$deployment/shared-release.path"
    [ -d "$release" ] || exit 74
fi
python="$release/surfaces/python-runtime/bin/python"
manifest="$release/runtime-manifest.json"
[ -x "$python" ] || exit 75
[ -r "$manifest" ] || exit 76

"$python" -c 'import json,sys; d=json.load(open(sys.argv[1], encoding="utf-8")); raise SystemExit(0 if d.get("status")=="SEALED_DEPLOYABLE_RUNTIME" else 77)' "$manifest"

export PYTHONPATH="$release/source"

run_loopback_only() {
    [ -x /usr/bin/sandbox-exec ] || exit 85
    policy='(version 1)
(allow default)
(deny network*)
(allow network-bind (local ip))
(allow network-inbound (local ip))
(allow network-outbound (remote ip "localhost:*"))'
    exec /usr/bin/sandbox-exec -p "$policy" "$@"
}

case "$IK_CELL_SERVICE_ROLE" in
    model)
        model_runtime="$release/surfaces/model-runtime/ollama"
        [ -x "$model_runtime" ] || exit 79
        : "${OLLAMA_HOST:?OLLAMA_HOST is required}"
        case "$OLLAMA_HOST" in
            127.0.0.1:*) model_port=${OLLAMA_HOST#127.0.0.1:} ;;
            *) exit 86 ;;
        esac
        require_port "$model_port"
        run_loopback_only "$model_runtime" serve
        ;;
    router)
        : "${HERMES_HOME:?HERMES_HOME is required}"
        [ "$HERMES_HOME" = "$cell_root/current-profile/primary" ] || exit 80
        : "${IK_SERVICE_HOST:=127.0.0.1}"
        : "${IK_SERVICE_PORT:?IK_SERVICE_PORT is required}"
        [ "$IK_SERVICE_HOST" = "127.0.0.1" ] || exit 86
        require_port "$IK_SERVICE_PORT"
        : "${IK_CELL_CREDENTIAL_FILE:?IK_CELL_CREDENTIAL_FILE is required}"
        [ "$IK_CELL_CREDENTIAL_FILE" = "$cell_root/current-profile/router/.env" ] || exit 87
        cd "$release/source"
        run_loopback_only "$python" -m ik_lifecycle.credential_exec \
            --policy router \
            --credential "$IK_CELL_CREDENTIAL_FILE" -- \
            "$python" -m uvicorn ik_extensions.model_workers.router_service:app --host "$IK_SERVICE_HOST" --port "$IK_SERVICE_PORT"
        ;;
    compatibility-gateway)
        : "${HERMES_HOME:?HERMES_HOME is required}"
        [ "$HERMES_HOME" = "$cell_root/current-profile/primary" ] || exit 81
        : "${IK_CELL_CREDENTIAL_FILE:?IK_CELL_CREDENTIAL_FILE is required}"
        : "${IK_CELL_SHARED_CREDENTIAL_FILE:?IK_CELL_SHARED_CREDENTIAL_FILE is required}"
        [ "$IK_CELL_CREDENTIAL_FILE" = "$cell_root/current-profile/compatibility-gateway/.env" ] || exit 87
        [ "$IK_CELL_SHARED_CREDENTIAL_FILE" = "$cell_root/current-profile/compatibility-gateway/shared-core.env" ] || exit 87
        : "${IK_SERVICE_HOST:=127.0.0.1}"
        : "${IK_SERVICE_PORT:?IK_SERVICE_PORT is required}"
        [ -r "$deployment/compatibility/app.py" ] || exit 82
        cd "$deployment/compatibility"
        exec "$python" -m ik_lifecycle.credential_exec \
            --policy compatibility \
            --credential "$IK_CELL_CREDENTIAL_FILE" \
            --credential "$IK_CELL_SHARED_CREDENTIAL_FILE" -- \
            "$python" -m uvicorn app:app --host "$IK_SERVICE_HOST" --port "$IK_SERVICE_PORT"
        ;;
    gateway)
        : "${HERMES_HOME:?HERMES_HOME is required}"
        case "$HERMES_HOME" in
            "$cell_root/current-profile/primary"|"$cell_root/current-profile/fast") ;;
            *) exit 83 ;;
        esac
        cd "$release/source"
        if [ "$HERMES_HOME" = "$cell_root/current-profile/primary" ]; then
            : "${IK_CELL_ROUTER_CREDENTIAL_FILE:?IK_CELL_ROUTER_CREDENTIAL_FILE is required}"
            : "${IK_CELL_SHARED_CREDENTIAL_FILE:?IK_CELL_SHARED_CREDENTIAL_FILE is required}"
            [ "$IK_CELL_ROUTER_CREDENTIAL_FILE" = "$cell_root/current-profile/router/.env" ] || exit 87
            [ "$IK_CELL_SHARED_CREDENTIAL_FILE" = "$cell_root/current-profile/compatibility-gateway/shared-core.env" ] || exit 87
            exec "$python" -m ik_lifecycle.credential_exec \
                --policy compatibility \
                --credential "$IK_CELL_SHARED_CREDENTIAL_FILE" \
                --credential "$IK_CELL_ROUTER_CREDENTIAL_FILE" -- \
                "$python" -m hermes_cli.main gateway run --replace
        fi
        exec "$python" -m hermes_cli.main gateway run --replace
        ;;
    *) exit 84 ;;
esac
