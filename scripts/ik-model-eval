#!/usr/bin/env python3
"""Load or score frozen IK model eval fixtures; never downloads models."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

from ik_extensions.model_workers.eval_harness import load_cases


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--fixtures", type=Path, required=True)
    parser.add_argument("--list", action="store_true")
    args = parser.parse_args()
    cases = load_cases(args.fixtures)
    if not args.list:
        raise SystemExit("model execution requires a separate artifact/runtime approval")
    print(json.dumps([case.__dict__ for case in cases], sort_keys=True, default=dict))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
